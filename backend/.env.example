# EVORA Backend Environment Configuration
# Copy this file to .env and configure values as needed

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///./evora.db
SQLITE_DB_PATH=./evora.db

# Live Weather Integration (Open-Meteo public REST API, free and requires no key)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567
DEFAULT_CITY=Pune

# Optional External API Keys (Leave blank for public/demo fallbacks)
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
JWT_SECRET_KEY=your_jwt_secret_key_here
